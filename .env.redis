# Redis Configuration for Data Sync AI
# High-Performance Caching Layer Settings

# Redis Connection Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis Performance Tuning (Optional)
# REDIS_MAX_CONNECTIONS=20
# REDIS_SOCKET_TIMEOUT=5
# REDIS_CONNECTION_TIMEOUT=5

# Application Settings (keep existing settings)
# FABRIC_SQL_SERVER=your_server.database.windows.net
# FABRIC_SQL_DATABASE=your_database
# TENANT_ID=your_tenant_id
# CLIENT_ID=your_client_id
# CLIENT_SECRET=your_client_secret

# Performance Monitoring
ENABLE_PERFORMANCE_LOGGING=true
ENABLE_CACHE_METRICS=true
